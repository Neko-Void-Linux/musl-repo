# Template file for 'scenefx0.5'

pkgname=scenefx0.5
version=0.5
revision=6
build_style=meson
configure_args="-Dwerror=false -Db_ndebug=false"
hostmakedepends="pkg-config wayland-devel scdoc"
makedepends="wlroots0.20-devel"
short_desc="Drop-in replacement for the wlroots scene API - 0.5 series"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://github.com/wlrfx/scenefx"
changelog="https://github.com/wlrfx/scenefx/releases/"
distfiles="https://github.com/wlrfx/scenefx/archive/refs/tags/${version}.tar.gz"
checksum=0fa8ecca0e310f813efd052624c5ed7d9153d6a0fdead5cc957d34c07f9a86c6

conflicts="scenefx>=0"
shlib_provides="libscenefx-0.5.so"

pre_install() {
	find ${wrksrc} -name "*.rej" -delete
	find ${wrksrc} -name "*.orig" -delete
}

post_install() {
	vlicense LICENSE
}

scenefx0.5-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		if [ -d "${DESTDIR}/usr/lib64/pkgconfig" ]; then
			vmove usr/lib64/pkgconfig
		else
			vmove usr/lib/pkgconfig
		fi
	}
}
